{
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/cron/class-reminders",
      "schedule": "* * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/dev/simulation",
      "destination": "/dev/simulation.html"
    },
    {
      "source": "/dev",
      "destination": "/dev/simulation.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
