{
  "version": 2,
  "builds": [
    {
      "src": "api/broadcast.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/send-direct.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/reminder-check.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/cron/class-reminders.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "admin/**",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "css/**",
      "use": "@vercel/static"
    },
    {
      "src": "js/**",
      "use": "@vercel/static"
    },
    {
      "src": "dev/**",
      "use": "@vercel/static"
    },
    {
      "src": "manifest.json",
      "use": "@vercel/static"
    },
    {
      "src": "favicon.svg",
      "use": "@vercel/static"
    },
    {
      "src": "firebase-messaging-sw.js",
      "use": "@vercel/static"
    },
    {
      "src": "sw.js",
      "use": "@vercel/static"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/class-reminders",
      "schedule": "* * * * *"
    }
  ],
  "routes": [
    {
      "src": "/api/broadcast",
      "dest": "/api/broadcast.js"
    },
    {
      "src": "/api/send-direct",
      "dest": "/api/send-direct.js"
    },
    {
      "src": "/api/reminder-check",
      "dest": "/api/reminder-check.js"
    },
    {
      "src": "/api/cron/class-reminders",
      "dest": "/api/cron/class-reminders.js"
    },
    {
      "src": "/admin",
      "dest": "/admin/index.html"
    },
    {
      "src": "/dev/simulation",
      "dest": "/dev/simulation.html"
    },
    {
      "src": "/dev",
      "dest": "/dev/simulation.html"
    },
    {
      "src": "/sw.js",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      },
      "dest": "/sw.js"
    },
    {
      "src": "/firebase-messaging-sw.js",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      },
      "dest": "/firebase-messaging-sw.js"
    },
    {
      "src": "/css/(.*)",
      "headers": {
        "cache-control": "public, max-age=0, must-revalidate"
      },
      "dest": "/css/$1"
    },
    {
      "src": "/js/(.*)",
      "headers": {
        "cache-control": "public, max-age=0, must-revalidate"
      },
      "dest": "/js/$1"
    },
    {
      "src": "/",
      "headers": {
        "cache-control": "public, max-age=0, must-revalidate"
      },
      "dest": "/index.html"
    },
    {
      "src": "/index.html",
      "headers": {
        "cache-control": "public, max-age=0, must-revalidate"
      },
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "headers": {
        "cache-control": "public, max-age=0, must-revalidate"
      },
      "dest": "/$1"
    }
  ]
}
