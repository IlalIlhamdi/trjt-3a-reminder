rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Schedules Collection (Jadwal Tetap TRJT 3A)
    // Mahasiswa can read public schedule; Only authenticated admin can write
    match /schedules/{scheduleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. Schedule Overrides & Cancellations (Perubahan Jam/Ruang/Batal)
    match /scheduleOverrides/{overrideId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. Registered Student Devices (FCM Push Tokens)
    match /devices/{deviceToken} {
      allow create, update: if true;
      allow read, delete: if request.auth != null;
    }

    // 4. Notification History & Logs
    match /notifications/{notifId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /notificationLogs/{logId} {
      allow read, write: if request.auth != null;
    }
  }
}
