rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Schedules & Overrides (Public read, admin write)
    match /schedules/{scheduleId} {
      allow read: if true;
      allow write: if request.auth != null || request.resource.data.classId == 'trjt-3a';
    }

    match /scheduleOverrides/{overrideId} {
      allow read: if true;
      allow write: if request.auth != null || request.resource.data.classId == 'trjt-3a';
    }

    // 2. Registered Student Devices
    match /devices/{deviceToken} {
      allow read: if true;
      allow write: if request.resource.data.classId == 'trjt-3a';
    }

    // 3. Notification History & Logs
    match /notifications/{notifId} {
      allow read: if true;
      allow write: if request.resource.data.classId == 'trjt-3a';
    }

    match /notificationsLog/{logId} {
      allow read: if true;
      allow write: if true;
    }

    match /notificationLogs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    // 4. Course Folders & Materials
    match /courseFolders/{folderId} {
      allow read: if true;
      allow write: if request.auth != null || request.resource.data.classId == 'trjt-3a';
    }

    match /courseMaterials/{materialId} {
      allow read: if true;
      allow write: if true;
    }

    // 5. Course Assignments
    match /courseAssignments/{assignmentId} {
      allow read: if true;
      allow write: if true;
    }

    // 6. System Config (Restricted read/write to protect OAuth & tokens)
    match /systemConfig/{configId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
