rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Schedules Collection (Jadwal Tetap TRJT 3A)
    match /schedules/{scheduleId} {
      allow read, write: if true;
    }

    // 2. Schedule Overrides & Cancellations (Perubahan Jam/Ruang/Batal)
    match /scheduleOverrides/{overrideId} {
      allow read, write: if true;
    }

    // 3. Registered Student Devices (FCM Push Tokens)
    match /devices/{deviceToken} {
      allow read, write: if true;
    }

    // 4. Notification History & Logs
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    match /notificationsLog/{logId} {
      allow read, write: if true;
    }

    match /notificationLogs/{logId} {
      allow read, write: if true;
    }

    // 5. Google Drive Course Folders (Folder ID Mapping)
    match /courseFolders/{folderId} {
      allow read, write: if true;
    }

    // 6. Course Materials Metadata (File references)
    match /courseMaterials/{materialId} {
      allow read, write: if true;
    }

    // 7. System Config (Drive Auth, Upload settings)
    match /systemConfig/{configId} {
      allow read, write: if true;
    }
  }
}
